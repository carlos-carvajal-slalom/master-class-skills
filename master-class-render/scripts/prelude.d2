vars: {
  d2-config: {
    theme-id: 0
  }
}
classes: {
  model: {style: {fill: "#e7efff"; stroke: "#3b5bdb"; font-color: "#1c2f7a"; border-radius: 12}}
  code: {style: {fill: "#e6f6e9"; stroke: "#2b8a3e"; font-color: "#1b5e2a"; border-radius: 6}}
  tool: {style: {fill: "#fff1dc"; stroke: "#e8590c"; font-color: "#8a3500"; border-radius: 6}}
  data: {shape: cylinder; style: {fill: "#f1f3f5"; stroke: "#495057"}}
  person: {shape: person; style: {fill: "#f8f0fc"; stroke: "#862e9c"}}
  bad: {style: {fill: "#ffe3e3"; stroke: "#c92a2a"; font-color: "#a51111"}}
  good: {style: {fill: "#e6fcf5"; stroke: "#099268"; font-color: "#08604a"}}
  note: {shape: page; style: {fill: "#fff59d"; stroke: "#d4b106"; font-color: "#3d3200"; font-size: 22; bold: true}}
  muted: {style: {opacity: 0.45; stroke-dash: 4}}
  json: {shape: text; style: {font-size: 16; font-color: "#343a40"}}
  wrong: {style: {stroke: "#c92a2a"; font-color: "#c92a2a"; stroke-dash: 5}}
}
*.style.font-size: 22
(* -> *)[*].style.font-size: 18
